# Server-side NVIDIA key used by /api/models and /api/chat.
# Set this in Vercel Project Settings -> Environment Variables for production.
# Do not use NEXT_PUBLIC_* for secrets.
NVIDIA_API_KEY=your_nvidia_api_key_here

# Optional but recommended when users save custom keys in Settings.
# Use a long random value so encrypted custom-key cookies survive server restarts/deploys.
NVIDIA_COOKIE_SECRET=replace_with_a_long_random_secret
